rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(familyId) {
      return request.auth != null && request.auth.uid == familyId;
    }

    function validIdentifier(value) {
      return value.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$');
    }

    function validFamilyDocument(data, familyId) {
      return data.keys().size() == 2
        && data.ownerId is string
        && data.ownerId == familyId
        && data.updatedAt is timestamp;
    }

    function validProgression(data) {
      return [
        data is map,
        data.keys().size() == 4,
        data.version is int,
        data.version >= 1,
        data.version <= 100,
        data.completedMissionIds is list,
        data.completedMissionIds.size() <= 30,
        data.unlockedMissionIds is list,
        data.unlockedMissionIds.size() <= 30,
        data.lastMissionId is int,
        data.lastMissionId >= 1,
        data.lastMissionId <= 30
      ].hasOnly([true]);
    }

    function validMastery(data) {
      return [
        data is map,
        data.keys().size() == 3,
        data.math is number,
        data.math >= 0,
        data.math <= 100,
        data.words is number,
        data.words >= 0,
        data.words <= 100,
        data.spanish is number,
        data.spanish >= 0,
        data.spanish <= 100
      ].hasOnly([true]);
    }

    function validSettings(data) {
      return [
        data is map,
        data.keys().size() == 11,
        data.reducedMotion is bool,
        data.cameraMotionReduction is bool,
        data.largeTargets is bool,
        data.highContrast is bool,
        data.captions is bool,
        data.dyslexicFont is bool,
        data.textScale is string,
        data.textScale.size() <= 8,
        data.qualityTier is string,
        data.qualityTier.size() <= 24,
        data.soundOn is bool,
        data.musicOn is bool,
        data.enemySpeed is string,
        data.enemySpeed.size() <= 24
      ].hasOnly([true]);
    }

    function validControls(data) {
      return [
        data is map,
        data.keys().size() == 4,
        data.dailyMinutes is int,
        data.dailyMinutes >= 1,
        data.dailyMinutes <= 240,
        data.maxSessionMinutes is int,
        data.maxSessionMinutes >= 1,
        data.maxSessionMinutes <= 120,
        data.maxSessionMinutes <= data.dailyMinutes,
        data.requireParentForSnap is bool,
        data.requireParentForPractice is bool
      ].hasOnly([true]);
    }

    function validLearningCoreHub(data) {
      return [
        data is map,
        data.keys().size() == 4,
        data.variant is string,
        data.variant.size() <= 32,
        data.expansionUnlocked is bool,
        data.visibleChangeCount is number,
        data.visibleChangeCount >= 0,
        data.visibleChangeCount <= 1000000,
        data.upgrades is list,
        data.upgrades.size() <= 64
      ].hasOnly([true]);
    }

    function validLearningCore(data) {
      return [
        data is map,
        data.keys().size() == 8,
        data.version is int,
        data.version >= 1,
        data.version <= 100,
        data.stage is string,
        data.stage.size() <= 32,
        data.completedStages is list,
        data.completedStages.size() <= 32,
        data.skills is map,
        data.skills.size() <= 200,
        data.mastery is map,
        data.mastery.size() <= 200,
        data.rewards is list,
        data.rewards.size() <= 200,
        data.rewardLedger is map,
        data.rewardLedger.size() <= 200,
        validLearningCoreHub(data.hub)
      ].hasOnly([true]);
    }

    function validOptionalProfileCollections(data) {
      return [
        data.programmableBits is map,
        data.programmableBits.size() <= 64,
        data.codeLabProjects is map,
        data.codeLabProjects.size() <= 50,
        data.codeBridgeLessons is map,
        data.codeBridgeLessons.size() <= 100,
        data.programmableBitLessons is map,
        data.programmableBitLessons.size() <= 100,
        data.bubbleReefRewards is map,
        data.bubbleReefRewards.size() <= 8
      ].hasOnly([true]);
    }

    function validOptionalProfileScalars(data) {
      return data.equippedCosmetic is string && data.equippedCosmetic.size() <= 64
        && data.activeProgrammableBitId is string && data.activeProgrammableBitId.size() <= 32
        && data.updatedAt is number && data.updatedAt >= 0;
    }

    // Packed writer counters are bounded opaque JSON here. Runtime ingress
    // validates every writer ID, sequence, total and aggregate before merging.
    function validCurrencyLedger(data, profileId) {
      return [
        data is map,
        data.keys().size() == 7,
        data.version is int,
        data.version == 1,
        data.profileId == profileId,
        data.legacy is map,
        data.legacy.keys().size() == 3,
        data.legacy.score is int,
        data.legacy.score >= 0,
        data.legacy.score <= 1000000000,
        data.legacy.stars is int,
        data.legacy.stars >= 0,
        data.legacy.stars <= 1000000000,
        data.legacy.spark is int,
        data.legacy.spark >= 0,
        data.legacy.spark <= 1000000000,
        data.missions is string,
        data.missions.matches('[0le]{30}'),
        data.preview is string,
        data.preview.matches('[0le]'),
        data.purchases is string,
        data.purchases.matches('[0le]{4}'),
        data.writers is string,
        data.writers.size() <= 131072
      ].hasOnly([true]);
    }

    function validCurrencyTransition(previous, next) {
      return next.displayName == ''
        || !('currencyLedger' in previous.progress)
        || ('currencyLedger' in next.progress);
    }

    function validLiveProgress(data, profileId, displayName) {
      let keys = data.keys();
      return [
        data is map,
        keys.size() == (('currencyLedger' in data) ? 28 : 27),
        data.id == profileId,
        data.name == displayName,
        data.score is number,
        data.score >= 0,
        data.score <= 1000000000,
        data.stars is number,
        data.stars >= 0,
        data.stars <= 1000000000,
        data.spark is number,
        data.spark >= 0,
        data.spark <= 1000000000,
        data.bestCombo is number,
        data.bestCombo >= 0,
        data.bestCombo <= 1000000,
        data.bite is string,
        data.bite.size() >= 1,
        data.bite.size() <= 40,
        data.unlockedBites is list,
        data.unlockedBites.size() <= 32,
        data.cosmetics is list,
        data.cosmetics.size() <= 128,
        data.skills is map,
        data.skills.size() <= 200,
        data.mistakes is list,
        data.mistakes.size() <= 100,
        data.practice is list,
        data.practice.size() <= 100,
        data.snap is list,
        data.snap.size() == 0,
        data.sessions is list,
        data.sessions.size() <= 100,
        validProgression(data.progression),
        validMastery(data.mastery),
        validSettings(data.settings),
        validControls(data.controls),
        validLearningCore(data.learningCore),
        validOptionalProfileCollections(data),
        validOptionalProfileScalars(data)
      ].hasOnly([true]);
    }

    function validTombstone(data, profileId) {
      return data is map
        && data.keys().size() == 3
        && data.id == profileId
        && data.deleted is bool && data.deleted == true
        && data.deletedAt is int && data.deletedAt >= 0;
    }

    function validProfileDocument(data, profileId, familyId) {
      return [
        data.keys().size() == 5,
        data.ownerId is string,
        data.ownerId == familyId,
        validIdentifier(data.clientProfileId),
        data.clientProfileId == profileId,
        data.progress is map,
        data.displayName is string,
        data.displayName.size() <= 40,
        data.clientUpdatedAt is timestamp,
        ((data.displayName.size() >= 1
            && validLiveProgress(data.progress, profileId, data.displayName))
          || (data.displayName == ''
            && validTombstone(data.progress, profileId)
            && data.clientUpdatedAt.toMillis() == data.progress.deletedAt))
      ].hasOnly([true]);
    }

    function isStoredTombstone(data) {
      return data.progress is map
        && data.progress.get('deleted', false) == true;
    }

    match /families/{familyId} {
      allow read: if signedInAs(familyId)
        && resource.data.ownerId == request.auth.uid;

      allow create: if signedInAs(familyId)
        && validFamilyDocument(request.resource.data, familyId);

      allow update: if signedInAs(familyId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validFamilyDocument(request.resource.data, familyId);

      // Removing this parent document does not cascade its profile subcollection.
      allow delete: if false;

      match /profiles/{profileId} {
        // A document GET can inspect its stored owner and path ID. REST
        // listDocuments cannot prove either predicate for an unfiltered list,
        // so keep that GET check and scope collection reads to the UID path.
        allow get: if signedInAs(familyId)
          && resource.data.ownerId == request.auth.uid
          && resource.data.clientProfileId == profileId;

        allow list: if signedInAs(familyId);

        allow create: if signedInAs(familyId)
          && validProfileDocument(request.resource.data, profileId, familyId)
          && (!('currencyLedger' in request.resource.data.progress) || validCurrencyLedger(request.resource.data.progress.currencyLedger, profileId));

        allow update: if signedInAs(familyId)
          && resource.data.ownerId == familyId
          && resource.data.clientProfileId == profileId
          && validProfileDocument(request.resource.data, profileId, familyId)
          && validCurrencyTransition(resource.data, request.resource.data)
          && (!('currencyLedger' in request.resource.data.progress) || validCurrencyLedger(request.resource.data.progress.currencyLedger, profileId))
          && ((!isStoredTombstone(resource.data))
            || request.resource.data == resource.data);

        // A profile is deleted by replacing it with a permanent tombstone. A
        // privileged backend is required for full account-erasure cleanup.
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
